# Sao chép thành .env.local khi chạy máy cá nhân.
# Trên Coolify: khai báo từng biến trong tab Environment Variables, KHÔNG commit giá trị thật.

# Origin công khai, dùng để dựng redirect_uri gửi sang Google.
APP_URL=http://localhost:3000

# Google OAuth client (Web application).
# Authorized redirect URI phải khớp tuyệt đối: <APP_URL>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Khoá ký session cookie. Tạo bằng: openssl rand -hex 32
SESSION_SECRET=

# Ai được phép đăng nhập. Nhận domain (taki.vn) hoặc email cụ thể (a@b.com),
# phân tách bằng dấu phẩy. Đặt * để mở cho tất cả (không khuyến khích).
ALLOWED_EMAIL_DOMAINS=taki.vn

# Ai thấy được tab Quản trị. Cho phép nhiều email, phân tách bằng dấu phẩy.
TAKI_ADMIN_EMAIL=

# Nơi lưu file SQLite. Trong Docker trỏ vào volume gắn ở /data.
DATABASE_PATH=./data/saleslab.sqlite
